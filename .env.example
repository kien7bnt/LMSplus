# LMSPLUS E-Learning — PostgreSQL 18, Bảo mật & Lưu trữ (Mẫu cấu hình)
# Sao chép file này thành `.env` (chạy local) hoặc khai báo trên Vercel Environment Variables.
# TUYỆT ĐỐI KHÔNG đưa khóa bí mật thật vào Git.

# ------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL 18
# ------------------------------------------------------------------
DATABASE_URL=postgresql://lmsplus:lmsplus_dev_password@127.0.0.1:5432/lmsplus
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lmsplus
PGUSER=lmsplus
PGPASSWORD=lmsplus_dev_password
# Trên Production Cloud PG (Neon/RDS), khuyến nghị đặt `verify-full` hoặc chuỗi URL chuẩn TLS
PGSSLMODE=disable

# - auto (mặc định): Dùng PostgreSQL 18 nếu có DATABASE_URL hoặc PGHOST, ngược lại tự fallback SQLite.
# - postgres: Bắt buộc dùng PostgreSQL 18.
# - sqlite: Dùng SQLite cục bộ (chỉ dùng cho test cô lập).
LMSPLUS_DB_CLIENT=auto

# ------------------------------------------------------------------
# 2. BẢO MẬT PHIÊN, JWT & WEBHOOK (BẮT BUỘC TRÊN PRODUCTION)
# ------------------------------------------------------------------
# Tạo chuỗi ngẫu nhiên >= 32 ký tự: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production sẽ TỪ CHỐI khởi động nếu để trống hoặc dùng chuỗi mẫu.
LMSPLUS_JWT_SECRET=change-me-generate-at-least-32-random-characters-with-crypto
# Khóa mã hóa riêng cho thông tin OAuth tích hợp bên thứ 3 (tùy chọn; mặc định dẫn xuất từ JWT_SECRET)
LMSPLUS_CREDENTIAL_KEY=
# Danh sách domain frontend được phép gọi API CORS (ngăn cách bởi dấu phẩy)
LMSPLUS_ALLOWED_ORIGINS=http://localhost:5173,https://lmsplus-seven.vercel.app

# Mật khẩu khởi tạo quản trị viên tối thiểu 12 ký tự nếu DB Production hoàn toàn trống (không dùng '123456')
LMSPLUS_ADMIN_BOOTSTRAP_PASSWORD=
# Tuyệt đối giữ 0 trên Production; chỉ bật 1 khi chạy kiểm thử cục bộ/staging có chủ đích
LMSPLUS_ENABLE_TEST_ENDPOINTS=0
LMSPLUS_ALLOW_RESET_SEED=0

# ------------------------------------------------------------------
# 3. ZOOM / GOOGLE MEET WEBHOOK SECRETS (BẮT BUỘC KHI DÙNG PRODUCTION)
# ------------------------------------------------------------------
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_LIVE_API=0
GOOGLE_MEET_WEBHOOK_SECRET=
GOOGLE_MEET_LIVE_API=0

# ------------------------------------------------------------------
# 4. STORAGE ADAPTER (Local Disk cho Dev, S3 / Cloudflare R2 / Vercel Blob cho Production)
# ------------------------------------------------------------------
# - local (mặc định local dev): lưu tệp theo phân loại thư mục dưới backend/uploads/resources
# - s3 / r2: lưu qua S3-compatible Presigned PUT/GET (Cloudflare R2, AWS S3, MinIO)
# - vercel_blob: lưu trên Vercel Blob Store
LMSPLUS_STORAGE_PROVIDER=local
LMSPLUS_S3_ENDPOINT=
LMSPLUS_S3_REGION=auto
LMSPLUS_S3_BUCKET=
LMSPLUS_S3_ACCESS_KEY_ID=
LMSPLUS_S3_SECRET_ACCESS_KEY=
LMSPLUS_S3_PUBLIC_BASE_URL=
BLOB_READ_WRITE_TOKEN=
# Tùy chọn cấu hình unified adapter: LMSPLUS_STORAGE_BASE_URL, LMSPLUS_STORAGE_TOKEN, LMSPLUS_STORAGE_BUCKET
LMSPLUS_STORAGE_BASE_URL=
LMSPLUS_STORAGE_TOKEN=
LMSPLUS_STORAGE_BUCKET=

# ------------------------------------------------------------------
# 5. HIỆU NĂNG, POOLING & CACHE TẦNG DỊCH VỤ
# ------------------------------------------------------------------
HOST=127.0.0.1
DB_POOL_MAX=25
LMSPLUS_CACHE_TTL_MS=15000
LMSPLUS_CACHE_MAX_ENTRIES=2000
