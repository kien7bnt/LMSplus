# LMSPLUS E-Learning — PostgreSQL 18 & Runtime Configuration
# Sao chép file này thành .env (chạy local) hoặc khai báo trên Vercel Environment Variables.

# Ưu tiên kết nối qua DATABASE_URL (PostgreSQL 18 Docker local hoặc Neon / Supabase / Cloud Postgres 18)
DATABASE_URL=postgresql://lmsplus:lmsplus_dev_password@127.0.0.1:5432/lmsplus

# Hoặc cấu hình rời từng biến (tương thích psql / libpq / pg):
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lmsplus
PGUSER=lmsplus
PGPASSWORD=lmsplus_dev_password
PGSSLMODE=disable

# Chế độ chọn engine DB:
# - auto (mặc định): Dùng PostgreSQL 18 nếu có DATABASE_URL hoặc PGHOST, ngược lại tự fallback SQLite.
# - postgres: Bắt buộc dùng PostgreSQL 18.
# - sqlite: Dùng SQLite cục bộ (hữu ích cho test cô lập không cần Postgres daemon).
LMSPLUS_DB_CLIENT=auto

# Bảo mật JWT HS256 (Bắt buộc đặt chuỗi bí mật riêng trên môi trường Production)
LMSPLUS_JWT_SECRET=lmsplus-production-grade-hmac-secret-2026
